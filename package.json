{
  "name": "ocean-harness",
  "type": "module",
  "version": "0.1.13",
  "private": false,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "setup": "pnpm install && go -C src-server mod tidy",
    "web:dev": "vite",
    "web:build": "tsc -b && vite build",
    "web:lint": "eslint .",
    "web:lint:fix": "eslint . --fix",
    "web:test": "vitest run",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri",
    "tauri:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "server:mod:tidy": "go -C src-server mod tidy",
    "server:dev": "cd src-server && air",
    "server:test": "cross-env TAURI_RUN_MODE=dev node scripts/build-server.mjs",
    "server:release": "cross-env TAURI_RUN_MODE=build node scripts/build-server.mjs",
    "server:fmt": "gofmt -l -w src-server",
    "server:gorm:gen": "go -C src-server run ./cmd/gormgen -config=config/settings.dev.yaml",
    "gen:bindings": "cargo run --manifest-path src-tauri/Cargo.toml --features gen-bindings --bin export_bindings",
    "gen:app:icons": "tauri icon src/assets/app-icon.svg && rm -rf src-tauri/icons/android && rm -rf src-tauri/icons/ios && cp src-tauri/icons/icon.png src/assets/app-icon.png && cp src/assets/app-icon.svg public/favicon.svg",
    "verify:bindings": "pnpm gen:bindings && git ls-files --error-unmatch src/shared/bindings.ts && git diff --exit-code src/shared/bindings.ts",
    "release": "bumpp"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@icon-park/react": "^1.4.2",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@lezer/highlight": "^1.2.3",
    "@mui/icons-material": "^9.1.0",
    "@mui/material": "^9.1.0",
    "@mui/x-date-pickers": "^9.10.1",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@uiw/react-md-editor": "^4.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.21",
    "i18next": "^26.3.1",
    "katex": "^0.18.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.2",
    "react-zoom-pan-pinch": "^4.2.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "streamdown": "^2.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@eslint-react/eslint-plugin": "^5.8.17",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "bumpp": "^11.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.1",
    "eslint-plugin-format": "^1.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "prettier": "^3.6.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.11"
  }
}
