{
  "name": "ocean-harness",
  "type": "module",
  "version": "0.2.1",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "setup": "pnpm install && go -C server mod tidy",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "web:lint": "eslint .",
    "web:lint:fix": "eslint . --fix",
    "web:test": "pnpm --filter web test",
    "tauri:dev": "tauri dev --config app/tauri.dev.conf.json",
    "tauri:build:local": "tauri build --config app/tauri.build.local.conf.json",
    "tauri:build:ci": "tauri",
    "tauri:fmt": "cargo fmt --manifest-path app/Cargo.toml",
    "server:mod:tidy": "go -C server mod tidy",
    "server:dev": "cd server && air",
    "server:test": "TAURI_RUN_MODE=dev node scripts/build-server.mjs",
    "server:release": "TAURI_RUN_MODE=build node scripts/build-server.mjs",
    "server:fmt": "gofmt -l -w server",
    "server:gorm:gen": "go -C server run ./cmd/gormgen -config=config/settings.dev.yaml",
    "gen:bindings": "cargo run --manifest-path app/Cargo.toml --features gen-bindings --bin export_bindings",
    "gen:app:icons": "tauri icon packages/web/src/assets/app-icon.svg && rm -rf app/icons/android && rm -rf app/icons/ios && cp app/icons/icon.png packages/web/src/assets/app-icon.png && cp packages/web/src/assets/app-icon.svg packages/web/public/favicon.svg",
    "verify:bindings": "pnpm gen:bindings && git ls-files --error-unmatch packages/web/src/shared/bindings.ts && git diff --exit-code packages/web/src/shared/bindings.ts",
    "release": "bumpp"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@eslint-react/eslint-plugin": "catalog:",
    "@tauri-apps/cli": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
